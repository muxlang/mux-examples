// Use SQLite in memory for a deterministic, offline database example.

import std.sql

func run() returns result<int, SqlError> {
    auto connection = use sql.sqlite_memory()
    use connection.execute("CREATE TABLE items (name TEXT, quantity INTEGER)")
    auto inserted = use connection.execute_params(
        "INSERT INTO items (name, quantity) VALUES (?, ?)",
        [sql.string("apples"), sql.int(3)]
    )
    assert(inserted == 1, "one item should be inserted")

    auto result = use connection.query("SELECT name, quantity FROM items")
    auto maybe_row = use result.next()
    if maybe_row.is_none() {
        connection.close()
        return err(SqlError.from_message("query returned no rows"))
    }
    auto row = maybe_row.value()
    auto name = use row.values()[0].as_string()
    auto quantity = use row.values()[1].as_int()
    print("item: " + name)
    print("quantity: " + quantity.to_string())
    use result.close()
    connection.close()
    return ok(0)
}

func main() returns void {
    auto result = run()
    if result.is_err() {
        print(result.error().message())
        return
    }
    print("sql memory complete")
    return
}
