// An HTTP server and a client talking to each other over loopback.
//
// The server binds an ephemeral port on 127.0.0.1, a client runs on a second
// thread, and both shut down cleanly. Nothing leaves the machine and the port
// number never reaches the output, so the result is the same on every run.
//
// Two things about this code are worth more attention than the sockets.
//
// FIRST, the shape. Every fallible call returns a `result` and Mux has no
// exceptions and no propagation operator, so a nested `match` per call would
// bury the logic under indentation. The style used here instead is: declare the
// variable, `match` immediately, bind on `ok`, and RETURN on `err`. It costs
// four lines per call but the function stays flat and reads top to bottom.
// Prefer it over nesting once you have more than two fallible calls in a row.
//
// SECOND, reading a field. `stringify` gives back the JSON ENCODING of a value,
// so a string field arrives as `"/echo"` with the quotes. The typed accessors
// (`as_string`, `as_int`, ...) give back the value itself, and return an
// `optional` because a field holding the wrong kind is ordinary when reading a
// document you did not write.

import std.data.json
import std.net
import std.sync

// One string field of a JSON object, decoded.
//
// A missing key and a key holding a non-string are different failures, and both
// are reported rather than papered over with an empty string.
func field(map<string, Json> obj, string key) returns string {
    if !obj.contains(key) {
        return "<missing>"
    }
    match obj[key].as_string() {
        ok(text) { return text }
        err(e) { return "<not a string>" }
    }
}

// One integer field of a JSON object, as text.
//
// A status is a number in the document, so `as_string` would report it as the
// wrong kind. Which accessor to reach for is decided by what the field holds,
// not by what you want to do with it afterwards.
func int_field(map<string, Json> obj, string key) returns string {
    if !obj.contains(key) {
        return "<missing>"
    }
    match obj[key].as_int() {
        ok(n) { return n.to_string() }
        err(e) { return "<not an int>" }
    }
}

func response_for(string path) returns string {
    if path == "/health" {
        return "{\"status\":200,\"body\":{\"ok\":true}}"
    }
    if path == "/echo" {
        return "{\"status\":201,\"body\":{\"echoed\":true}}"
    }
    return "{\"status\":404,\"body\":{\"error\":\"no such route\"}}"
}

// Send one GET and report the status the server replied with.
//
// Returns the status as text rather than printing it, so the caller decides
// when it is shown. Two threads printing race, and an example whose line order
// can vary cannot be checked against a recorded output.
func fetch_status(string address) returns string {
    auto body = "{\"method\":\"GET\",\"url\":\"http://" + address + "/echo\"}"
    match json.parse(body) {
        ok(request) {
            match net.http.request(request) {
                ok(response) {
                    match json.to_map(response) {
                        ok(response_map) { return int_field(response_map, "status") }
                        err(e) { return "bad response: " + e }
                    }
                }
                err(e) { return "request failed: " + e }
            }
        }
        err(e) { return "bad request json: " + e }
    }
}

// Accept one connection, read the request, route on its path, and reply.
//
// The outer `match` cannot be flattened: `accept` yields a TcpStream, a class
// type, and a variable cannot be declared without initializing it, so there is
// nothing to bind before the match (mux-compiler#393). Everything after it is
// flattened by hand.
func serve_once(TcpListener listener) returns result<string, string> {
    match listener.accept() {
        ok(stream) {
            map<string, Json> request_map = {:}
            match net.http.read_request(stream) {
                ok(request) {
                    match json.to_map(request) {
                        ok(m) { request_map = m }
                        err(e) { stream.close() return err("not an object: " + e) }
                    }
                }
                err(e) { stream.close() return err("read failed: " + e) }
            }

            auto method = field(request_map, "method")
            auto path = field(request_map, "path")

            auto reply = json.parse(response_for(path))
            match reply {
                ok(response) {
                    match net.http.write_response(stream, response) {
                        ok(_) { stream.close() return ok(method + " " + path) }
                        err(e) { stream.close() return err("write failed: " + e) }
                    }
                }
                err(e) { stream.close() return err("bad response json: " + e) }
            }
        }
        err(e) { return err("accept failed: " + e) }
    }
}

func main() returns void {
    auto listener_result = net.TcpListener.bind("127.0.0.1:0")

    match listener_result {
        ok(listener) {
            auto address = ""
            match listener.local_addr() {
                ok(addr) { address = addr }
                err(e) {
                    print("bind address unavailable: " + e)
                    return
                }
            }

            // The client records its result rather than printing it. Two
            // threads printing race, and an example whose line order can vary
            // cannot be checked against a recorded output. `client_status` is
            // captured by the closure, so both sides name the same storage, and
            // `join` below is what makes the write visible here.
            auto client_status = "(never ran)"

            // The client runs on its own thread, because accept() blocks until
            // someone connects and the connection has to come from somewhere.
            //
            // The body is one assignment on purpose: the matching lives in
            // `fetch_status` and the closure only stores what it returns, so the
            // thread body says what it does rather than how.
            auto client = sync.spawn(func() returns void {
                client_status = fetch_status(address)
                return
            })

            match serve_once(listener) {
                ok(summary) { print("server handled " + summary) }
                err(e) { print("server error: " + e) }
            }

            match client {
                ok(thread) {
                    match thread.join() {
                        ok(_) { print("client saw status " + client_status) }
                        err(e) { print("join failed: " + e) }
                    }
                }
                err(e) { print("spawn failed: " + e) }
            }

            listener.close()
        }
        err(e) { print("could not bind: " + e) }
    }

    return
}
