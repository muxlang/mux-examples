// Read a CSV file and emit each row as a JSON object.
//
// This is the classic glue task: text in one shape, text out in another, with
// every step able to fail. `use` keeps the happy path flat while preserving the
// original error when any step fails.
//
// The program writes its own input file so it is self-contained, then removes
// it on the way out.

import std.fs
import std.data.csv
import std.data.json

const string DATA_FILE = "employees.csv"

func write_sample() returns result<void, fs.FsError> {
    string contents = "name,role,years\nAda,engineer,7\nGrace,admiral,12\nAlan,analyst,4"
    return fs.write_file(DATA_FILE, contents)
}

func cleanup_sample() returns void {
    auto removed = fs.remove(DATA_FILE)
    if removed.is_err() {
        print("cleanup failed: " + removed.error().message())
    }
    return
}

func convert() returns result<int, string> {
    auto wrote = write_sample()
    if wrote.is_err() {
        return err(wrote.error().message())
    }
    print("wrote " + DATA_FILE)

    auto raw_result = fs.read_file(DATA_FILE)
    if raw_result.is_err() {
        return err(raw_result.error().message())
    }
    auto raw = raw_result.value()

    auto table_result = csv.parse_with_headers(raw)
    if table_result.is_err() {
        return err(table_result.error().message())
    }
    auto table = table_result.value()
    print("columns: " + table.headers.to_string())
    print("rows:    " + table.rows.size().to_string())
    print("")

    // Rebuild each row as a name -> value map, then hand it to JSON. A short
    // row has no value at an index, so inspect the optional returned by `get`
    // instead of indexing directly.
    for list<string> row in table.rows {
        map<string, string> record = {:}
        for int i in range(0, table.headers.size()) {
            auto maybe_value = row.get(i)
            if maybe_value.is_some() {
                record[table.headers[i]] = maybe_value.value()
            } else {
                record[table.headers[i]] = ""
            }
        }

        auto obj_result = json.from_map(record)
        if obj_result.is_err() {
            cleanup_sample()
            return err(obj_result.error().message())
        }
        auto obj = obj_result.value()
        auto text_result = obj.stringify(none)
        if text_result.is_err() {
            cleanup_sample()
            return err(text_result.error().message())
        }
        auto text = text_result.value()
        print(text)
    }

    auto removed = fs.remove(DATA_FILE)
    if removed.is_err() {
        return err(removed.error().message())
    }
    print("")
    print("cleaned up " + DATA_FILE)
    return ok(0)
}

func main() returns void {
    auto result = convert()
    if result.is_err() {
        print("csv conversion failed: " + result.error())
        return
    }
    return
}
